# Neon Postgres (use pooler URL on Vercel serverless)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

PUBLIC_BASE_URL=https://www.serafinna.ru

# Static assets (JS/CSS via assetPrefix + photos).
# Vercel + flaky .ru path: keep default host vercel.app
# NEXT_PUBLIC_ASSET_HOST=https://serafinna.vercel.app
# API fallback host when www.serafinna.ru/api fails (browser)
# NEXT_PUBLIC_API_FALLBACK=https://serafinna.vercel.app
# Russian VPS / single origin: disable split
# NEXT_PUBLIC_ASSET_PREFIX=0
# See DEPLOY.md · deploy/cloudflare.md · deploy/vps-ru.md

SERAFINNA_ADMIN_USER=admin
SERAFINNA_ADMIN_PASS=
SERAFINNA_ADMIN_PATH=m-change-me
SERAFINNA_SECRET=

TELEGRAM_BOT_TOKEN=
